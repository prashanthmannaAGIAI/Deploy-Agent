# Runway local development settings.
# Copy to .env (git-ignored) and change every "change-me" value. Never commit .env.

# --- General ---------------------------------------------------------------
# dev | test | prod. Controls defaults such as log format and cookie security.
RUNWAY_ENV=dev
# Public URL of the web app (also used for Keycloak redirect URIs).
WEB_BASE_URL=http://localhost:3000
# URL the web app uses to reach the API.
API_BASE_URL=http://localhost:8000
# Origins allowed to call the API from a browser (JSON list).
API_CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL (docker compose) -------------------------------------------
# Superuser for the local Postgres container. Also used by Temporal in dev.
POSTGRES_USER=runway
POSTGRES_PASSWORD=change-me-postgres
# Application database, created on first start with the pgvector extension.
POSTGRES_DB=runway
# Host port for Postgres (bound to 127.0.0.1).
POSTGRES_PORT=5432
# SQLAlchemy URL for the API and worker (Phase 2). Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://runway:change-me-postgres@localhost:5432/runway

# --- Redis (log fan-out) ---------------------------------------------------
# Host port for Redis (bound to 127.0.0.1).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Temporal --------------------------------------------------------------
# Host port for the Temporal frontend (gRPC).
TEMPORAL_PORT=7233
# Address the API and worker use to reach Temporal.
TEMPORAL_ADDRESS=localhost:7233
# Temporal namespace for Runway workflows.
TEMPORAL_NAMESPACE=default
# Task queue the worker polls for deployment workflows (Phase 5).
TEMPORAL_TASK_QUEUE=runway-deploy
# Host port for the Temporal web UI.
TEMPORAL_UI_PORT=8233

# --- Keycloak (OIDC) -------------------------------------------------------
# Host port for Keycloak. Admin console: http://localhost:8081/admin
KEYCLOAK_PORT=8081
# Bootstrap admin for the Keycloak admin console (dev only).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# OIDC issuer the web app signs in against.
KEYCLOAK_ISSUER=http://localhost:8081/realms/runway
# OIDC client for the web app. The secret is injected into the realm on first import.
KEYCLOAK_WEB_CLIENT_ID=runway-web
KEYCLOAK_WEB_CLIENT_SECRET=change-me-web-client-secret

# --- Web app auth (Auth.js, Phase 1) ---------------------------------------
# Random 32+ byte string used to encrypt session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret

# --- AI agent (Phase 4) ----------------------------------------------------
# anthropic | ollama. ollama runs a local open-source model at zero cost.
LLM_PROVIDER=ollama
# Anthropic API key. Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Model for failure diagnosis, IaC generation and chat.
ANTHROPIC_MODEL=claude-sonnet-5
# Model for stack detection, classification and short answers.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Local Ollama server and model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Upper bound on input tokens sent to the model in a single request.
LLM_MAX_INPUT_TOKENS=30000

# --- Secrets (Phase 3) -----------------------------------------------------
# local | aws-kms | vault. "local" does envelope encryption with the key below.
SECRET_STORE=local
# Base64 32-byte key-encryption key for the local SecretStore. Generate: openssl rand -base64 32
LOCAL_SECRET_KEY=
